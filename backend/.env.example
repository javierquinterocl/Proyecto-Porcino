# ====================================
# CONFIGURACIÓN DEL BACKEND - Sistema Granme
# ====================================

# ========== BASE DE DATOS ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=porcime
DB_USER=postgres
DB_PASSWORD=admin123

# ========== JWT ==========
JWT_SECRET=tu_clave_secreta_super_segura_cambiala_en_produccion
JWT_EXPIRES_IN=24h


# ========== SERVIDOR ==========
PORT=3000
NODE_ENV=development

# ========== EMAIL (RECUPERACIÓN DE CONTRASEÑA) ==========
# Configuración del servidor SMTP para envío de emails
# Si no se configuran estas variables, la funcionalidad de email estará deshabilitada

# Host del servidor SMTP (ejemplos: smtp.gmail.com, smtp.outlook.com, smtp.mailtrap.io)
EMAIL_HOST=smtp.gmail.com

# Puerto del servidor SMTP
# 587 para TLS (recomendado)
# 465 para SSL
# 25 para conexiones sin cifrado (no recomendado)
EMAIL_PORT=587

# Correo electrónico desde el cual se enviarán los emails
EMAIL_USER=granmeporcino@gmail.com

# Contraseña del correo o App Password
# Para Gmail: https://myaccount.google.com/apppasswords
# Para Outlook: Configurar en configuración de cuenta
EMAIL_PASS=hfseaekjrhmadohu

# Nombre y correo que aparecerá como remitente (opcional)
# Si no se especifica, se usará EMAIL_USER
EMAIL_FROM="Sistema Granme <granmeporcino@gmail.com>"

# ========== FRONTEND ==========
# URL del frontend para los enlaces de recuperación de contraseña
# En desarrollo: http://localhost:5173
# En producción: https://tu-dominio.com
FRONTEND_URL=http://localhost:5173

# ====================================
# NOTAS IMPORTANTES
# ====================================

# 1. NUNCA subir este archivo a repositorios públicos
# 2. Crear un archivo .env basado en este ejemplo
# 3. Para Gmail, activar "Verificación en 2 pasos" y generar un "App Password"
# 4. Para testing, puedes usar Mailtrap (https://mailtrap.io)
# 5. Los tokens de recuperación expiran en 1 hora por seguridad

# ====================================
# CONFIGURACIÓN DE GMAIL
# ====================================
# 1. Ir a: https://myaccount.google.com/security
# 2. Activar "Verificación en 2 pasos"
# 3. Ir a: https://myaccount.google.com/apppasswords
# 4. Crear una nueva contraseña de aplicación
# 5. Usar esa contraseña en EMAIL_PASS

# ====================================
# CONFIGURACIÓN DE MAILTRAP (TESTING)
# ====================================
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=tu_usuario_mailtrap
# EMAIL_PASS=tu_password_mailtrap
